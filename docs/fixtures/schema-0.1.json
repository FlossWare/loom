{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flossware.org/loom/conformance/fixture-0.1.schema.json",
  "title": "Loom Conformance Fixture Envelope 0.1",
  "description": "Versioned, language-neutral envelope for Loom conformance fixtures. Domain-specific input and expected-outcome fields remain extensible.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "semantic_area",
    "contract",
    "expected"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "semantic_area": {
      "type": "string",
      "minLength": 1
    },
    "contract": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object"
    },
    "context": {
      "type": "object"
    },
    "expected": {
      "type": "object",
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
